<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>What If? — Summer Movie Wager 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>{{ theme_css | safe }}</style>
<style>{{ nav_css | safe }}</style>
<style>{{ shared_css | safe }}</style>
<style>
/* ── Sandbox layout ── */
.sandbox-controls { display:flex; justify-content:flex-end; margin:0 0 .6em; }
.reset-btn {
  font-family:'Nunito',sans-serif; font-size:.85em; font-weight:700;
  color:var(--text); background:var(--bg-card);
  border:2px solid var(--border); border-radius:50px;
  padding:.35em .9em; cursor:pointer; transition:background .15s,transform .1s;
}
.reset-btn:hover { background:var(--bg-hover); }
.reset-btn:active { transform:scale(.96); }

.whatif-layout { display:grid; grid-template-columns:1fr 300px; gap:1.2em; align-items:start; }
@media (max-width:700px) { .whatif-layout { grid-template-columns:1fr; } }

/* ── The sortable finish list ── */
.finish-list { list-style:none; counter-reset:slot; padding:0; margin:0; }
.finish-list li {
  counter-increment:slot;
  display:flex; align-items:center; gap:.6em;
  background:var(--bg-card); border:2px solid var(--border); border-radius:12px;
  padding:.5em .8em; margin:.35em 0; cursor:grab;
  box-shadow:0 1px 6px var(--shadow);
  transition:border-color .15s, opacity .2s;
  user-select:none; -webkit-user-select:none; touch-action:pan-y;
}
.finish-list li::before {
  content:counter(slot);
  font-weight:800; font-size:.9em; width:1.6em; flex:none;
  text-align:right; color:var(--text-muted); font-variant-numeric:tabular-nums;
}
.finish-list li .grip { color:var(--zero); font-size:1em; flex:none; }
.finish-list li .film-title { font-weight:700; }
.finish-list li .row-move { margin-left:auto; display:flex; gap:.2em; }
.move-btn {
  font-family:'Nunito',sans-serif; font-size:.8em; font-weight:700; line-height:1;
  color:var(--text-muted); background:transparent;
  border:2px solid var(--border); border-radius:8px;
  padding:.25em .45em; cursor:pointer;
}
.move-btn:hover { color:var(--text); background:var(--bg-hover); }
.finish-list li:hover { border-color:var(--accent-soft); }
.finish-list li.ghost { opacity:.25; }
.finish-list li.chosen { border-color:var(--accent); cursor:grabbing; }
/* the scoring cutoff — pure CSS, follows whatever card sits 10th */
.finish-list li:nth-child(10) { border-bottom:3px dashed var(--accent); margin-bottom:2em; position:relative; }
.finish-list li:nth-child(10)::after {
  content:"▼ below this line doesn't score";
  position:absolute; left:.2em; bottom:-1.7em;
  font-size:.75em; font-weight:800; letter-spacing:.03em; color:var(--accent);
}
.finish-list li:nth-child(n+11) { opacity:.55; }
.footnote { color:var(--text-muted); font-size:.82em; margin:.8em 0 1.4em; }

/* ── Live standings panel ── */
.standings {
  background:var(--bg-card); border-radius:14px; padding:1em 1.1em;
  box-shadow:0 2px 16px var(--shadow); position:sticky; top:1em;
}
.standings h2 {
  font-size:.85em; font-weight:800; text-transform:uppercase; letter-spacing:.05em;
  color:var(--th-color); margin:0 0 .6em;
}
.stand-row {
  display:flex; align-items:center; gap:.5em;
  padding:.4em .5em; border-radius:9px; font-variant-numeric:tabular-nums;
}
.stand-row .place { width:1.4em; text-align:right; font-weight:800; color:var(--text-muted); font-size:.9em; }
.stand-row .who { flex:1; font-weight:700; }
.stand-row .pts { font-weight:800; }
.stand-row .delta { width:2.4em; text-align:right; font-size:.8em; font-weight:800; }
.stand-row .delta.up   { color:var(--win-color); }
.stand-row .delta.down { color:#ff6b6b; }
.stand-row .delta.flat { color:var(--zero); }
.stand-row.leader { background:var(--win-bg); }
.stand-row.leader .who, .stand-row.leader .pts, .stand-row.leader .place { color:var(--win-color); }

/* ── Points grid (same visual language as Winning Scenarios) ── */
.grid-caption { margin:1.4em 0 .8em; font-weight:700; }
.grid-caption .muted { color:var(--text-muted); font-weight:600; font-size:.9em; }
</style>
</head>
<body>
{% include "_theme.html.j2" %}
{% include "_nav.html.j2" %}

<h1>🎬 What If?</h1>
<p class="subtitle">Drag the top-15 projected films into any finish order and watch
  every player's score update. Only the top 10 score — the dashed line marks the cutoff.</p>

<div class="gated" id="gated">
  ⏳ Not enough films are in theaters yet to simulate win probabilities{% if forecast_unavailable_reason %} — {{ forecast_unavailable_reason }}{% endif %}. This view unlocks once the forecast is live.
</div>

<div id="view">
  <div class="sandbox-controls"><button class="reset-btn" id="reset">↺ Reset to projected order</button></div>
  <div class="whatif-layout">
    <ol id="finish" class="finish-list"></ol>
    <aside class="standings" id="standings" aria-live="polite"></aside>
  </div>
  <p class="footnote">Films outside the projected top 15 can't be dragged in and score 0.</p>
  <div class="grid-caption">Points by film <span class="muted">— what each film at each rank contributes to every player</span></div>
  <div class="grid-wrap">
    <table id="grid">
      <thead><tr id="head"></tr></thead>
      <tbody id="body"></tbody>
      <tfoot><tr id="foot"></tr></tfoot>
    </table>
  </div>
</div>

<footer>
  Refreshed {{ generated_at }}.
</footer>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"
        integrity="sha384-HZZ/fukV+9G8gwTNjN7zQDG0Sp7MsZy5DDN6VfY3Be7V9dvQpEpR2jF2HlyFUUjU" crossorigin="anonymous"></script>
<script>
const DATA = {{ whatif_json | safe }};

const esc = s => s.replace(/[&<>"']/g,
  c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

/* ── scoring: exact port of score/rules.py ── */
function rankedPickPoints(predicted, actual) {          // actual 0 = missed
  if (actual === 0) return 0;
  const d = Math.abs(predicted - actual);
  if (d === 0) return (actual === 1 || actual === 10) ? 13 : 10;
  if (d === 1) return 7;
  if (d === 2) return 5;
  return 3;
}
function scoreBreakdown(player, topTitles) {
  const pos = new Map(topTitles.map((t, i) => [t, i + 1]));
  const out = new Array(topTitles.length).fill(0);
  player.ranked.forEach((t, i) => {
    const p = pos.get(t) || 0;
    if (p) out[p - 1] += rankedPickPoints(i + 1, p);
  });
  player.dark_horses.forEach(t => {
    const p = pos.get(t) || 0;
    if (p) out[p - 1] += 1;
  });
  return out;
}
const scorePlayer = (p, top) => scoreBreakdown(p, top).reduce((a, b) => a + b, 0);

/* competition ranking: tied points share a place (1, 1, 3) */
function places(rows) {                                  // rows sorted by pts desc
  let place = 0, prev = null;
  return rows.map((r, i) => {
    if (r.pts !== prev) { place = i + 1; prev = r.pts; }
    return place;
  });
}

const finishEl = document.getElementById("finish");
const standEl = document.getElementById("standings");
const headEl = document.getElementById("head");
const bodyEl = document.getElementById("body");
const footEl = document.getElementById("foot");

function buildList() {
  finishEl.innerHTML = DATA.movies.map((t, i) =>
    `<li data-i="${i}"><span class="grip">⠿</span><span class="film-title">${esc(t)}</span>
      <span class="row-move">
        <button class="move-btn" data-dir="-1" aria-label="Move ${esc(t)} up">▲</button>
        <button class="move-btn" data-dir="1" aria-label="Move ${esc(t)} down">▼</button>
      </span></li>`
  ).join("");
}
const currentTop10 = () =>
  [...finishEl.children].slice(0, 10).map(li => DATA.movies[+li.dataset.i]);

/* baseline standings from the initial projected order, for movement deltas */
const baselinePlaces = (() => {
  const top = DATA.movies.slice(0, 10);
  const rows = DATA.players.map(p => ({u: p.username, pts: scorePlayer(p, top)}))
                           .sort((a, b) => b.pts - a.pts);
  const pl = places(rows);
  return Object.fromEntries(rows.map((r, i) => [r.u, pl[i]]));
})();

function renderStandings(rows, pl) {
  standEl.innerHTML = "<h2>🏆 If it ends this way…</h2>" + rows.map((r, i) => {
    const diff = baselinePlaces[r.u] - pl[i];
    const delta = diff > 0 ? `<span class="delta up">▲${diff}</span>`
                : diff < 0 ? `<span class="delta down">▼${-diff}</span>`
                :            `<span class="delta flat">–</span>`;
    const crown = pl[i] === 1 ? ' <span class="crown">👑</span>' : "";
    return `<div class="stand-row${pl[i] === 1 ? " leader" : ""}">
      <span class="place">${pl[i]}</span>
      <span class="who">${esc(r.u)}${crown}</span>
      <span class="pts">${r.pts}</span>${delta}</div>`;
  }).join("");
}

function renderGrid(rows, pl, top10) {
  headEl.innerHTML = `<th class="film-col">Hypothetical top-10 finish</th>` +
    rows.map((r, i) => `<th class="${pl[i] === 1 ? "col-sel" : ""}">${esc(r.u)}</th>`).join("");
  bodyEl.innerHTML = top10.map((film, i) => {
    const cells = rows.map((r, c) => {
      const v = r.grid[i];
      const cls = (v === 0 ? "zero " : "") + (pl[c] === 1 ? "col-sel" : "");
      return `<td class="${cls.trim()}">${v || "·"}</td>`;
    }).join("");
    return `<tr><td class="film-col"><span class="rank">${i + 1}.</span>${esc(film)}</td>${cells}</tr>`;
  }).join("");
  footEl.innerHTML = `<td class="film-col">Total</td>` +
    rows.map((r, i) => {
      const crown = pl[i] === 1 ? ' <span class="crown">👑</span>' : "";
      return `<td class="${pl[i] === 1 ? "win" : ""}">${r.pts}${crown}</td>`;
    }).join("");
}

function rescore() {
  const top10 = currentTop10();
  const rows = DATA.players.map(p => ({
    u: p.username,
    pts: scorePlayer(p, top10),
    grid: scoreBreakdown(p, top10),
  })).sort((a, b) => b.pts - a.pts);
  const pl = places(rows);
  renderStandings(rows, pl);
  renderGrid(rows, pl, top10);
}

new Sortable(finishEl, {
  animation: 150,
  ghostClass: "ghost",
  chosenClass: "chosen",
  delay: 150, delayOnTouchOnly: true, touchStartThreshold: 4,
  filter: ".move-btn", preventOnFilter: false,
  onEnd: rescore,
});
finishEl.addEventListener("click", e => {
  const btn = e.target.closest(".move-btn");
  if (!btn) return;
  const li = btn.closest("li");
  const target = +btn.dataset.dir < 0 ? li.previousElementSibling : li.nextElementSibling;
  if (!target) return;                       // ▲ on first row / ▼ on last row: no-op
  if (+btn.dataset.dir < 0) finishEl.insertBefore(li, target);
  else finishEl.insertBefore(target, li);
  btn.focus();                               // repeated presses keep walking the film
  rescore();
});
document.getElementById("reset").onclick = () => { buildList(); rescore(); };

const FORECAST_AVAILABLE = {{ 'true' if forecast_available else 'false' }};
if (!FORECAST_AVAILABLE) {
  document.getElementById("view").style.display = "none";
  document.getElementById("gated").style.display = "block";
} else {
  buildList();
  rescore();
}
</script>
</body>
</html>
